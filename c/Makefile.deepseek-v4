# DeepSeek V4 amalgamation build — x86-64/aarch64 Linux and Windows/MSYS2 only.
# Uses GNU ld -Wl,--wrap and gcc -march; do not invoke from macOS/PowerPC
# `make check` (the parent Makefile gates COLI_V4_SUPPORTED).

ifeq ($(OS),Windows_NT)
IS_WIN := 1
UNAME_S :=
UNAME_M :=
else
IS_WIN :=
UNAME_S := $(shell uname -s 2>/dev/null)
UNAME_M := $(shell uname -m 2>/dev/null)
endif

COLI_V4_OK :=
ifeq ($(IS_WIN),1)
COLI_V4_OK := 1
else ifeq ($(UNAME_S),Linux)
ifneq (,$(filter x86_64 amd64 aarch64 arm64,$(UNAME_M)))
COLI_V4_OK := 1
endif
endif

ifneq ($(COLI_V4_OK),1)
$(error Makefile.deepseek-v4 supports only x86-64/aarch64 Linux and Windows/MSYS2)
endif

ifneq ($(IS_WIN),)
CC = gcc
ARCH ?= x86-64-v3
CFLAGS = -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 -O3 -march=$(ARCH) -fopenmp \
	-include pthread.h -Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -static -pthread
V4_BINARY := deepseek_v4.exe
else
CC = gcc
ARCH ?= native
CFLAGS = -D_GNU_SOURCE -O3 -march=$(ARCH) -fopenmp -pthread -include pthread.h \
	-Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -pthread
V4_BINARY := deepseek_v4
endif

LTO ?= 1
ifeq ($(LTO),1)
CFLAGS += -flto
LDFLAGS += -flto
endif

include Makefile.deepseek-v4.units

TARGET_OBJS = $(addsuffix .o,$(V4_TARGET_UNITS))
TEST_UNIT_OBJS = $(addsuffix .o,$(V4_TEST_UNITS))
V4_OBJS = $(TARGET_OBJS)

# --- CUDA DS4 expert backend (ported from ZacharyZcR fork; arch-agnostic) ---
# CUDA=1 compiles backend_cuda_dsv4.cu with nvcc and links the DS4 kernels
# into deepseek_v4. CUDA_ARCH=native => build GPU SASS (default); explicit
# CUDA_ARCH=sm_86 or portable multi-gencode list target other GPUs.
CUDA ?= 0
ifeq ($(CUDA),1)
# --- shared CUDA arch selection (Linux + Windows) ---
CUDA_ARCH ?= native
ifeq ($(strip $(CUDA_ARCH)),)
CUDA_ARCH = native
endif
ifeq ($(CUDA_ARCH),portable)
CUDA_GENCODE = -gencode arch=compute_80,code=sm_80 \
               -gencode arch=compute_86,code=sm_86 \
               -gencode arch=compute_89,code=sm_89 \
               -gencode arch=compute_90,code=sm_90 \
               -gencode arch=compute_120,code=sm_120
else
CUDA_GENCODE = -arch=$(CUDA_ARCH)
endif
CFLAGS += -DCOLI_DSV4_CUDA

ifeq ($(IS_WIN),1)
# --- Windows: CUDA backend is a runtime DLL, loaded by backend_loader_dsv4.c ---
# MinGW gcc cannot link the nvcc/MSVC COFF object (MSVC-COFF refs
# __GSHandlerCheck/__security_cookie). The host therefore links the loader and
# resolves the dsv4_cuda_* symbols from coli_dsv4_cuda.dll at runtime. Host
# never links cudart. Run `make ... dsv4-cuda-dll` from a vcvars64 shell.
CUDA_HOME ?= $(subst \,/,$(CUDA_PATH))
NVCC ?= $(CUDA_HOME)/bin/nvcc.exe
NVCCFLAGS ?= -O3 -std=c++17 $(CUDA_GENCODE) -Xcompiler=-W3
DSV4_CUDA_OBJ = backend_loader_dsv4.o
V4_OBJS += $(DSV4_CUDA_OBJ)

$(DSV4_CUDA_OBJ): backend_loader_dsv4.c backend_cuda_dsv4.h
	$(CC) $(CFLAGS) -c backend_loader_dsv4.c -o $@

# Build coli_dsv4_cuda.dll (nvcc + MSVC cl.exe as host compiler). Requires the
# MSVC environment (vcvars64) so cl.exe is on PATH; CUDA bin dir too for nvcc.
.PHONY: dsv4-cuda-dll
dsv4-cuda-dll: backend_cuda_dsv4.cu backend_cuda_dsv4.h
	@"$(NVCC)" $(NVCCFLAGS) -shared -DCOLI_DSV4_CUDA_BUILDING_DLL \
		-L"$(CUDA_HOME)/lib/x64" -lcudart -lcublasLt \
		backend_cuda_dsv4.cu -o coli_dsv4_cuda.dll
else
# --- Linux: link the nvcc-compiled object directly ---
CUDA_HOME ?= /usr/local/cuda
NVCC ?= $(CUDA_HOME)/bin/nvcc
NVCCFLAGS ?= -O3 -std=c++17 $(CUDA_GENCODE)
DSV4_CUDA_OBJ = backend_cuda_dsv4.o
V4_OBJS += $(DSV4_CUDA_OBJ)
LDFLAGS += -L$(CUDA_HOME)/lib64 -Wl,-rpath,$(CUDA_HOME)/lib64 \
           -lcudart -lcublasLt -lstdc++

$(DSV4_CUDA_OBJ): backend_cuda_dsv4.cu backend_cuda_dsv4.h
	"$(NVCC)" $(NVCCFLAGS) -c backend_cuda_dsv4.cu -o $@
endif
endif

.PHONY: deepseek-v4 deepseek-v4-clean deepseek-v4-test-objs
deepseek-v4: $(V4_BINARY)

$(V4_BINARY): $(V4_OBJS)
	$(CC) $(V4_OBJS) -o $@ $(LDFLAGS)

$(TARGET_OBJS) $(TEST_UNIT_OBJS): %.o: deepseek_v4.c deepseek_v4.h \
	deepseek_v4_internal.h deepseek_v4_dspark.inc st.h json.h compat.h tensor.h quant.h \
	native_quant.h native_quant_batch.h native_quant_dual.h \
	native_quant_fp4_rows16.h
	$(CC) $(CFLAGS) -D$* -c deepseek_v4.c -o $@

deepseek-v4-test-objs: $(TEST_UNIT_OBJS)

deepseek-v4-clean:
	rm -f $(V4_BINARY) $(V4_OBJS) $(TEST_UNIT_OBJS)
