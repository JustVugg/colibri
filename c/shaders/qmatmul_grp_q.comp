#version 450
// The grouped GEMM of our own formats' experts (vk_chain.c, vkc_moe_rows: a prompt chunk's
// routed experts on the dense chain): qmatmul_grp_bd.comp's structure, items and expert
// table, with qmatmul.comp's formats in place of the ggml blocks, from the table's words:
// 1 int8 rows (a scale per row), 2 int4 rows (a scale per row), 4 int4 with a scale per
// gs inputs (gs % 8 == 0); int4 nibbles as v + 8, element k at bits 4k of its word.
// Float arithmetic, no matrix units, any subgroup size (the matrix units' grouped GEMM,
// qmatmul_grp.comp, needs subgroups of 64).
//   y[s,o]   = sum_i x[s,i] * w[o,i]                                       (default)
//   hid[s,o] = silu(gate[s,o]) * up[s,o], clamped as expert_act.comp's act 0  (-DGATE_UP)
// A workgroup of 256 takes an item: 32 rows of one expert and BO outputs (32 with GATE_UP,
// its two matrices, else 64), through the input in steps of 64: half its threads decode
// the step's weights (32 a thread, of one row) into shared memory, the other half stage
// the 32 rows' 64 inputs; then each thread accumulates one output against 4 rows
// (GATE_UP, for both matrices) or 8. Host gates: I % 64 == 0.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer WRef { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer SRef { float v[]; };
layout(std430, binding = 0) readonly buffer X  { vec4 x4[]; };     // packed rows of all experts
layout(std430, binding = 1) readonly buffer IT { uvec4 items[]; };  // (expert, first row, output block, -)
layout(std430, binding = 2) readonly buffer ET { uint etab[]; };    // 16 uints per expert (qmatmul_grp.comp's)
layout(std430, binding = 3) writeonly buffer Y { float y[]; };      // packed output rows
layout(std430, binding = 4) readonly buffer AM { int amap[]; };     // kgat > 0: qmatmul_grp.comp's
layout(push_constant) uniform P { int I, O; float limit; int ibase; int kgat; int rpw; } p;

#define TM 32u
#ifdef GATE_UP
#define BO 32u
#else
#define BO 64u
#endif
#define TK 64u
#define LDK 68u
#define LDV (LDK / 4u)
shared vec4 wg4[BO * LDV];         // the block's decoded rows (the gate's with GATE_UP)
#ifdef GATE_UP
shared vec4 wu4[BO * LDV];         // and the up's
#endif
shared vec4 xs4[TM * LDV];         // the 32 rows' inputs

// row o's weights k..k+31 (fmt 1: eight words of int8, else four of int4) times their scales,
// into the tile's row r of the matrix's shared rows from vec4 i0 on
void put_row(WRef w, SRef sc, uint fmt, uint rowWords, uint gs, uint o, uint k, uint K, bool up, uint r, uint i0) {
    uint base = o * rowWords;
    if (fmt == 1u) {
        float s = sc.v[o];
        [[unroll]] for (uint j = 0u; j < 8u; j++) {
            uint v = w.v[base + k / 4u + j];
            vec4 f = vec4(float(int(v << 24) >> 24), float(int(v << 16) >> 24), float(int(v << 8) >> 24), float(int(v) >> 24)) * s;
#ifdef GATE_UP
            if (up) { wu4[r * LDV + i0 + j] = f; continue; }
#endif
            wg4[r * LDV + i0 + j] = f;
        }
        return;
    }
    uint ng = (K + gs - 1u) / max(gs, 1u);
    [[unroll]] for (uint j = 0u; j < 4u; j++) {
        uint v = w.v[base + k / 8u + j];
        float s = fmt == 4u ? sc.v[o * ng + (k + 8u * j) / gs] : sc.v[o];
        vec4 lo = (vec4(float(v & 15u), float((v >> 4) & 15u), float((v >> 8) & 15u), float((v >> 12) & 15u)) - 8.0) * s;
        vec4 hi = (vec4(float((v >> 16) & 15u), float((v >> 20) & 15u), float((v >> 24) & 15u), float(v >> 28)) - 8.0) * s;
#ifdef GATE_UP
        if (up) { wu4[r * LDV + i0 + 2u * j] = lo; wu4[r * LDV + i0 + 2u * j + 1u] = hi; continue; }
#endif
        wg4[r * LDV + i0 + 2u * j] = lo; wg4[r * LDV + i0 + 2u * j + 1u] = hi;
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uvec4 it = items[uint(p.ibase) + gl_WorkGroupID.x];
    uint eb = it.x * 16u;
    WRef gw = WRef(uvec2(etab[eb + 0u], etab[eb + 1u])); SRef gsc = SRef(uvec2(etab[eb + 2u], etab[eb + 3u]));
#ifdef GATE_UP
    WRef uw = WRef(uvec2(etab[eb + 4u], etab[eb + 5u])); SRef usc = SRef(uvec2(etab[eb + 6u], etab[eb + 7u]));
#endif
    uint S = etab[eb + 8u], xoff = etab[eb + 9u], fmt = etab[eb + 10u], rowWords = etab[eb + 11u], gs = etab[eb + 12u];
    uint s0 = it.y, o0 = it.z * BO, K = uint(p.I), O = uint(p.O);
#ifdef GATE_UP
    uint ty = tid / 8u, tx = tid % 8u;    // output o0 + ty, rows s0 + tx + 8j
    vec4 ag[4], au[4];
    [[unroll]] for (int j = 0; j < 4; j++) { ag[j] = vec4(0.0); au[j] = vec4(0.0); }
#else
    uint ty = tid / 4u, tx = tid % 4u;    // output o0 + ty, rows s0 + tx + 4j
    vec4 ac[8];
    [[unroll]] for (int j = 0; j < 8; j++) ac[j] = vec4(0.0);
#endif
    for (uint k0 = 0u; k0 < K; k0 += TK) {
        barrier();   // the last step is read (and, the first time, the tables are in)
        if (tid < 128u) {   // decode: (matrix,) row, which of the step's two 32-weight halves
#ifdef GATE_UP
            bool up = (tid >> 6) != 0u; uint r = (tid >> 1) & 31u;
            WRef w = up ? uw : gw; SRef sc = up ? usc : gsc;
#else
            bool up = false; uint r = tid >> 1;
            WRef w = gw; SRef sc = gsc;
#endif
            uint o = min(o0 + r, O - 1u), h = tid & 1u;
            put_row(w, sc, fmt, rowWords, gs, o, k0 + 32u * h, K, up, r, 8u * h);
        } else {            // the rows' inputs: 32 x 64 values, 16 a thread
            for (uint e = tid - 128u; e < TM * TK / 4u; e += 128u) {
                uint r = e / (TK / 4u), c4 = e - r * (TK / 4u);
                bool ok = s0 + r < S;
                uint xr = xoff + s0 + min(r, S - 1u - s0);
#ifdef GATE_UP
                if (p.kgat > 0) xr = uint(amap[xr]) / uint(p.kgat);
#endif
                xs4[r * LDV + c4] = ok ? x4[(xr * K + k0) / 4u + c4] : vec4(0.0);
            }
        }
        barrier();
        [[unroll]] for (uint k4 = 0u; k4 < TK / 4u; k4++) {
#ifdef GATE_UP
            vec4 wg = wg4[ty * LDV + k4], wu = wu4[ty * LDV + k4];
            [[unroll]] for (int j = 0; j < 4; j++) {
                vec4 xv = xs4[(tx + 8u * uint(j)) * LDV + k4];
                ag[j] += wg * xv; au[j] += wu * xv;
            }
#else
            vec4 w = wg4[ty * LDV + k4];
            [[unroll]] for (int j = 0; j < 8; j++) ac[j] += w * xs4[(tx + 4u * uint(j)) * LDV + k4];
#endif
        }
    }
    uint o = o0 + ty;
    if (o >= O) return;
#ifdef GATE_UP
    [[unroll]] for (int j = 0; j < 4; j++) {
        uint s = s0 + tx + 8u * uint(j);
        if (s >= S) continue;
        float g = (ag[j].x + ag[j].y) + (ag[j].z + ag[j].w), u = (au[j].x + au[j].y) + (au[j].z + au[j].w);
        if (p.limit > 0.0) { if (g > p.limit) g = p.limit; if (u > p.limit) u = p.limit; if (u < -p.limit) u = -p.limit; }
        y[(xoff + s) * O + o] = (g / (1.0 + exp(-g))) * u;
    }
#else
    [[unroll]] for (int j = 0; j < 8; j++) {
        uint s = s0 + tx + 4u * uint(j);
        if (s >= S) continue;
        uint yr = xoff + s;
        if (p.kgat > 0) yr = uint(amap[yr]);
        y[yr * O + o] = (ac[j].x + ac[j].y) + (ac[j].z + ac[j].w);
    }
#endif
}
