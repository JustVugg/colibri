#version 450
// The expert batch's grouped GEMM for a GGUF's experts (backend_vulkan.c, xb_grp_record mode
// 3): one dispatch covers every expert of a batch, qmatmul_grp.comp's items and expert
// table, the weights the file's blocks (100 + ggml type T, a specialization constant)
// read by address and decoded by bdstep.glsl; float arithmetic, no matrix units, any
// subgroup size.
//   y[s,o]   = sum_i x[s,i] * w[o,i]                                       (default)
//   hid[s,o] = silu(gate[s,o]) * up[s,o], clamped as expert_act.comp's act 0  (-DGATE_UP)
// A workgroup of 256 takes an item: 32 rows of one expert and BO outputs (32 with GATE_UP,
// its two matrices, else 64), through the input in steps of 64: half its threads decode
// the step's 64 weights of the block's rows (two 32-weight steps a row) into shared
// memory, the other half stage the 32 rows' 64 inputs; then each thread accumulates one
// output against 4 rows (GATE_UP, for both matrices) or 8 from vec4 reads, rows 68
// floats apart (the 8 lanes of a phase on 8 bank groups). Host gates: I % 64 == 0 and
// every expert of the batch in the batch's types.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const int T = 12;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer WRef { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer WRef4 { uvec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer TRef { uint v[]; };   // blockdec_table.h's table
layout(std430, binding = 0) readonly buffer X  { vec4 x4[]; };     // packed rows of all experts
layout(std430, binding = 1) readonly buffer IT { uvec4 items[]; };  // (expert, first row, output block, -)
layout(std430, binding = 2) readonly buffer ET { uint etab[]; };    // 16 uints per expert (qmatmul_grp.comp's; [14..15] the table)
layout(std430, binding = 3) writeonly buffer Y { float y[]; };      // packed output rows
layout(std430, binding = 4) readonly buffer AM { int amap[]; };     // kgat > 0: qmatmul_grp.comp's
layout(push_constant) uniform P { int I, O; float limit; int ibase; int kgat; int rpw; } p;

#define TM 32u
#ifdef GATE_UP
#define BO 32u
#else
#define BO 64u
#endif
#define TK 64u
#define LDK 68u
#define LDV (LDK / 4u)
shared vec4 wg4[BO * LDV];         // the block's decoded rows (the gate's with GATE_UP)
#ifdef GATE_UP
shared vec4 wu4[BO * LDV];         // and the up's
#endif
shared vec4 xs4[TM * LDV];         // the 32 rows' inputs
shared float bs_kvt[16];
shared uint bs_grid[2048];
shared uint bs_ks[128];

WRef g_bw; WRef4 g_bw4; bool g_b16; TRef g_tab;
uint g_row, g_k0; int g_mat;       // the decoding thread's tile row, the step's first vec4, its matrix
void bs_put(vec4 w, uint i) {
#ifdef GATE_UP
    if (g_mat != 0) { wu4[g_row * LDV + i - g_k0] = w; return; }
#endif
    wg4[g_row * LDV + i - g_k0] = w;
}
#define BS_W1(i) g_bw.v[i]
#define BS_W4(i) (g_b16 ? g_bw4.v[i] : uvec4(g_bw.v[4u * (i)], g_bw.v[4u * (i) + 1u], g_bw.v[4u * (i) + 2u], g_bw.v[4u * (i) + 3u]))
#define BS_ACC(w, i) bs_put((w), (i))
#define BS_G(i) g_tab.v[i]
#include "bdstep.glsl"

void main() {
    uint tid = gl_LocalInvocationID.x;
    uvec4 it = items[uint(p.ibase) + gl_WorkGroupID.x];
    uint eb = it.x * 16u;
    uvec2 ga = uvec2(etab[eb + 0u], etab[eb + 1u]);
#ifdef GATE_UP
    uvec2 ua = uvec2(etab[eb + 4u], etab[eb + 5u]);
#endif
    uint S = etab[eb + 8u], xoff = etab[eb + 9u], rowWords = etab[eb + 11u];
    uint s0 = it.y, o0 = it.z * BO, K = uint(p.I), O = uint(p.O);
    g_tab = TRef(uvec2(etab[eb + 14u], etab[eb + 15u]));
    bs_tables_fill(T, int(tid));
#ifdef GATE_UP
    uint ty = tid / 8u, tx = tid % 8u;    // output o0 + ty, rows s0 + tx + 8j
    vec4 ag[4], au[4];
    [[unroll]] for (int j = 0; j < 4; j++) { ag[j] = vec4(0.0); au[j] = vec4(0.0); }
#else
    uint ty = tid / 4u, tx = tid % 4u;    // output o0 + ty, rows s0 + tx + 4j
    vec4 ac[8];
    [[unroll]] for (int j = 0; j < 8; j++) ac[j] = vec4(0.0);
#endif
    for (uint k0 = 0u; k0 < K; k0 += TK) {
        barrier();   // the last step is read (and, the first time, the tables are in)
        if (tid < 128u) {   // decode: (matrix,) row, which of the step's two 32-weight halves
#ifdef GATE_UP
            g_mat = int(tid >> 6); uint r = (tid >> 1) & 31u;
            uvec2 a = g_mat != 0 ? ua : ga;
#else
            g_mat = 0; uint r = tid >> 1;
            uvec2 a = ga;
#endif
            g_bw = WRef(a); g_bw4 = WRef4(a); g_b16 = (a.x & 15u) == 0u;
            uint o = min(o0 + r, O - 1u);
            g_row = r; g_k0 = k0 / 4u;
            bs_step(T, o * rowWords * 4u, k0 / 32u + (tid & 1u));
        } else {            // the rows' inputs: 32 x 64 values, 16 a thread
            for (uint e = tid - 128u; e < TM * TK / 4u; e += 128u) {
                uint r = e / (TK / 4u), c4 = e - r * (TK / 4u);
                bool ok = s0 + r < S;
                uint xr = xoff + s0 + min(r, S - 1u - s0);
#ifdef GATE_UP
                if (p.kgat > 0) xr = uint(amap[xr]) / uint(p.kgat);
#endif
                xs4[r * LDV + c4] = ok ? x4[(xr * K + k0) / 4u + c4] : vec4(0.0);
            }
        }
        barrier();
        [[unroll]] for (uint k4 = 0u; k4 < TK / 4u; k4++) {
#ifdef GATE_UP
            vec4 wg = wg4[ty * LDV + k4], wu = wu4[ty * LDV + k4];
            [[unroll]] for (int j = 0; j < 4; j++) {
                vec4 xv = xs4[(tx + 8u * uint(j)) * LDV + k4];
                ag[j] += wg * xv; au[j] += wu * xv;
            }
#else
            vec4 w = wg4[ty * LDV + k4];
            [[unroll]] for (int j = 0; j < 8; j++) ac[j] += w * xs4[(tx + 4u * uint(j)) * LDV + k4];
#endif
        }
    }
    uint o = o0 + ty;
    if (o >= O) return;
#ifdef GATE_UP
    [[unroll]] for (int j = 0; j < 4; j++) {
        uint s = s0 + tx + 8u * uint(j);
        if (s >= S) continue;
        float g = (ag[j].x + ag[j].y) + (ag[j].z + ag[j].w), u = (au[j].x + au[j].y) + (au[j].z + au[j].w);
        if (p.limit > 0.0) { if (g > p.limit) g = p.limit; if (u > p.limit) u = p.limit; if (u < -p.limit) u = -p.limit; }
        y[(xoff + s) * O + o] = (g / (1.0 + exp(-g))) * u;
    }
#else
    [[unroll]] for (int j = 0; j < 8; j++) {
        uint s = s0 + tx + 4u * uint(j);
        if (s >= S) continue;
        uint yr = xoff + s;
        if (p.kgat > 0) yr = uint(amap[yr]);
        y[yr * O + o] = (ac[j].x + ac[j].y) + (ac[j].z + ac[j].w);
    }
#endif
}
