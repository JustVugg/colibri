#version 450
// qmatmul_mm8 -- the tiled weight-stationary GEMM for fmt 12 (fp8 e4m3 weights, one
// f32 scale a row per 128-input group): a prompt's rows (S >= 2) against the dense
// chain's projections, the answer for devices without cooperative matrices
// (COLI_VK_MM8, vk_chain.c matmul_aligned's mm8 arm; the fork's issue #46 kernel,
// ported with the scale staging rewritten for this tree's format). Skeleton adapted
// from llama.cpp ggml-vulkan/vulkan-shaders/mul_mm.comp @ 972d2313 (MIT (c) 2023-2026
// The ggml authors), non-coopmat scalar path; staging helpers follow mul_mm_funcs.glsl.
// The e4m3 decode and the fp32 accumulation contract are this repo's qmatmul.comp
// (the deployed numerics class).
//
// NUMERICS (the port's contract, re-derived -- the fork's "bitwise vs the fmt=8
// matvec" claim does NOT carry: that matvec accumulated one k-ascending fp32 sum the
// way this kernel does, while this repo's fmt-12 GEMV (qmatmul.spv) strides the row
// across a subgroup's lanes -- a per-word fp32 partial scaled per group, then a
// subgroup tree -- so the two kernels associate the same exact terms differently).
// What holds here, on the production data class (x values on the e4m3 grid, e4m3
// weights, power-of-two UE8M0-derived scales):
//   * the terms are IDENTICAL: the weight's group scale is folded at staging
//     (w*sc, exact for a power-of-two scale outside the fp32 denormal range, the
//     CPU rows8 kernel's own `values = fp8 * scale` fold), x is read as f32;
//   * each output keeps ONE fp32 accumulator over the full K, k ascending, no
//     per-word partial and no fp64, so every tile variant of this kernel produces
//     the same bits (the test's variant sweep asserts it) and two runs are
//     byte-identical;
//   * vs the fp64/e4m3 reference and vs the fmt-12 GEMV the result is THRESHOLDED,
//     NOT BITWISE -- an envelope the test measures per shape (vk-chain-check's mm8
//     arms). The GEMV comparison is an observation, never a gate.
// FMA contraction is safe on that class (an exact product cannot round differently
// fused or unfused); random wide-exponent data is out of the class by design.
//
// k_split (the fork's T2): 0/1 = no split (grid.x the O tiles only). >1 = the K range
// cut into k_split word-aligned chunks, grid.x = (O tiles x k_split), each workgroup
// writing its PARTIAL tile into y at ik*(S*O) + out_idx; qmatmul_mm8_reduce.spv sums
// the planes in ascending k afterwards (deterministic, no atomics) -- a reassociation
// class of this kernel's own unsplit sum, not bitwise.
//
// Recipe: glslc --target-env=vulkan1.2 qmatmul_mm8.comp -o qmatmul_mm8.spv
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer X  { float x[]; };   // [S][I] fp32 (the e4m3 grid)
layout(std430, binding = 1) readonly buffer W  { uint  w[]; };   // [O][rowWords] packed e4m3
layout(std430, binding = 2) readonly buffer Sc { float scale[]; }; // f32, [O][ng]: a row a gs-input group
layout(std430, binding = 3) writeonly buffer Y { float y[]; };   // [S][O] (the partial planes when split)

layout(push_constant) uniform PC {
    int S;        // rows of x (>= 2: the host refuses less, the GEMV keeps them)
    int I;        // reduction dim (a multiple of 64: the host gates the arm)
    int O;        // weight rows
    int rowWords; // uint32 words per weight row
    int gs;       // scale group size (a multiple of 4: a word never straddles a group)
    int k_split;  // 0/1 unsplit; >1 the partial-tile convention above
} p;

// The tile is a SPEC-CONSTANT set (golden mul_mm.comp ids 0-10; id 9 TK is
// coopmat-only, declared for map parity), one pipeline per set through
// VkSpecializationInfo (vk_chain.c's tile table). Every variant keeps the SAME
// per-output accumulation -- one thread owns (s,o) over the full K, k ascending --
// so the numerics above are tile-independent. WARP is a thread-partition constant,
// NOT a subgroup size: this path uses no subgroup operations and no cross-lane
// reduction. The defaults are the fork's frozen tile (128t / 32x64 / BK32).
layout(constant_id = 0)  const uint BLOCK_SIZE = 128;
layout(constant_id = 1)  const uint BM = 32;   // O rows per workgroup tile
layout(constant_id = 2)  const uint BN = 64;   // S rows per workgroup tile
layout(constant_id = 3)  const uint BK = 32;   // k elements per staged block
layout(constant_id = 4)  const uint WM = 32;
layout(constant_id = 5)  const uint WN = 32;
layout(constant_id = 6)  const uint WMITER = 2;
layout(constant_id = 7)  const uint TM = 2;
layout(constant_id = 8)  const uint TN = 2;
layout(constant_id = 9)  const uint TK = 1;    // coopmat-only; unused here
layout(constant_id = 10) const uint WARP = 64; // thread partition, NOT a subgroup
/* 2 = ping-pong (double-buffered) staging, 0 (and any value but 2) = the single
 * buffer. The host sets 2 when the doubled LDS fits the device's shared-memory
 * limit, 0 when it does not. */
layout(constant_id = 11) const uint NDBUF = 0;
const uint NBUF = NDBUF == 2u ? 2u : 1u;

const uint SHMEM_STRIDE = BK / 2 + 1;          // golden non-coopmat pad = 1
shared vec2 buf_a[NBUF * BM * SHMEM_STRIDE];  // weights: e4m3 decoded x the group scale
shared vec2 buf_b[NBUF * BN * SHMEM_STRIDE];   // activations: fp32 pairs
uint abase(uint b) { return b * (BM * SHMEM_STRIDE); }
uint bbase(uint b) { return b * (BN * SHMEM_STRIDE); }

// e4m3 decode -- VERBATIM from qmatmul.comp (do not edit; the LUT form is
// deliberately rejected: RADV LUT gather ~1.5 GB/s vs 265+ GB/s arithmetic).
float e4m3(uint word, int lane) {
    uint b = (word >> (uint(lane) * 8u)) & 0xffu;
    if ((b & 0x7fu) == 0x7fu) return uintBitsToFloat(0x7fc00000u);
    uint e = (b >> 3u) & 0xfu, m = b & 7u;
    float v = e == 0u ? float(m) * 0.001953125f : ldexp(1.0f + float(m) * 0.125f, int(e) - 7);
    return (b & 0x80u) != 0u ? -v : v;
}

void store_a(uint b, uint m, uint k_pair, vec2 v) { buf_a[abase(b) + m * SHMEM_STRIDE + k_pair] = v; }
void store_b(uint b, uint n, uint k_pair, vec2 v) { buf_b[bbase(b) + n * SHMEM_STRIDE + k_pair] = v; }

// W staging (golden load_a_to_shmem pattern; the scale fold at staging follows the
// golden IQ branches' db*FLOAT_TYPEV2 precedent -- an exact power-of-two shift
// outside the fp32 denormal/overflow range). One thread = one uint32 word = 4 e4m3
// values = 2 float2. THE PORT'S SCALE LAYOUT: one f32 a ROW a gs-input group
// (backend_vulkan.c scale_floats, fmt 12): scale[o*ng + i0/gs] with ng = (I+gs-1)/gs
// -- NOT the fork's 128x128 blocks. Tails zero-fill: sc=0 => 0-products, which equal
// the GEMV's dropped tail terms.
void load_a_to_shmem(uint sb, uint o0, uint loadr, uint loadc, uint block) {
    const uint o = o0 + loadc;                   // feature row (local O space)
    const int i0 = int(block) + int(loadr) * 4;  // absolute k of first byte
    uint wv = 0u;
    float sc = 0.0f;
    if (o < uint(p.O) && i0 < p.I) {
        const uint ng = (uint(p.I) + uint(p.gs) - 1u) / uint(p.gs);
        wv = w[o * uint(p.rowWords) + uint(i0 / 4)];
        sc = scale[o * ng + uint(i0 / p.gs)];
    }
    store_a(sb, loadc, loadr * 2u,      vec2(e4m3(wv, 0) * sc, e4m3(wv, 1) * sc));
    store_a(sb, loadc, loadr * 2u + 1u, vec2(e4m3(wv, 2) * sc, e4m3(wv, 3) * sc));
}

// X staging (golden load_b_to_shmem DATA_A_F32 pattern; guards zero-fill the S and
// I tails -- zero products are exact, and stores are guarded anyway).
void load_b_to_shmem(uint sb, uint s0, uint loadr, uint loadc, uint block) {
    const uint s = s0 + loadc;                   // token row (local S space)
    const int i0 = int(block) + int(loadr) * 2;
    vec2 v = vec2(0.0f);
    if (s < uint(p.S) && i0 + 1 < p.I)
        v = vec2(x[s * uint(p.I) + i0], x[s * uint(p.I) + i0 + 1]);
    else if (s < uint(p.S) && i0 < p.I)
        v = vec2(x[s * uint(p.I) + i0], 0.0f);
    store_b(sb, loadc, loadr, v);
}

/* The compute stage for one staged K-block, slot-parameterized so the ping-pong and
 * single-buffer loops share it VERBATIM (identical FMA sequence per accumulator =>
 * bitwise between the two). SLOT = staging slot index. */
#define MM8_COMPUTE(SLOT)\
            [[unroll]] for (uint wq = 0; wq < BK / 4; wq++) { \
                vec2 ca0[WMITER * TM], ca1[WMITER * TM]; \
                [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) \
                    [[unroll]] for (uint j = 0; j < TM; j++) { \
                        const uint arow = warp_r * WM + wsir * WSUBM + tiwr * TM + j; \
                        ca0[wsir * TM + j] = buf_a[abase(SLOT) + arow * SHMEM_STRIDE + 2 * wq]; \
                        ca1[wsir * TM + j] = buf_a[abase(SLOT) + arow * SHMEM_STRIDE + 2 * wq + 1]; \
                    } \
                [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++) \
                    [[unroll]] for (uint cc = 0; cc < TN; cc++) { \
                        const uint brow = warp_c * WN + wsic * WSUBN + tiwc * TN + cc; \
                        const vec2 cb0 = buf_b[bbase(SLOT) + brow * SHMEM_STRIDE + 2 * wq]; \
                        const vec2 cb1 = buf_b[bbase(SLOT) + brow * SHMEM_STRIDE + 2 * wq + 1]; \
                        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) \
                            [[unroll]] for (uint j = 0; j < TM; j++) { \
                                const vec2 a0 = ca0[wsir * TM + j]; \
                                const vec2 a1 = ca1[wsir * TM + j]; \
                                const uint idx = (wsic * TN + cc) * WMITER * TM + wsir * TM + j; \
                                sums[idx] += a0.x * cb0.x; \
                                sums[idx] += a0.y * cb0.y; \
                                sums[idx] += a1.x * cb1.x; \
                                sums[idx] += a1.y * cb1.y; \
                            } \
                    } \
            } \

void main() {
    const uint ic = gl_WorkGroupID.y;            // golden :212 (N-tile = S-tile)
    const uint s0 = ic * BN;
    const uint blocks_m = (uint(p.O) + BM - 1) / BM;   // golden :235
    // k_split: grid.x = blocks_m * k_split; ik is the K-chunk index (0 when
    // unsplit), ir the M tile (golden :236).
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;
    const uint ksplit = p.k_split > 1 ? uint(p.k_split) : 1u;
    const uint kchunk = (uint(p.I) + ksplit - 1u) / ksplit;
    const uint start_k = ik * kchunk;
    const uint end_k = min(uint(p.I), start_k + kchunk);
    const uint o0 = ir * BM;

    const uint WNITER = (WM * WN) / (WARP * TM * TN * WMITER);  // golden :239
    const uint WSUBM = WM / WMITER;
    const uint WSUBN = WN / WNITER;

    const uint tid = gl_LocalInvocationID.x;
    const uint warp_i = tid / WARP;              // golden :255 (non-coopmat arm)
    const uint tiw = tid % WARP;
    const uint tiwr = tiw % (WSUBM / TM);        // golden :259
    const uint tiwc = tiw / (WSUBM / TM);
    const uint warp_r = warp_i % (BM / WM);      // golden :263
    const uint warp_c = warp_i / (BM / WM);

    // staging decomposition (golden :279-285): A in uint32 words (LOAD_VEC_A=4
    // bytes), B in float2 (LOAD_VEC_B=2 floats)
    const uint loadr_a = tid % (BK / 4);
    const uint loadc_a = tid / (BK / 4);
    const uint loadstride_a = BLOCK_SIZE * 4 / BK;
    const uint loadr_b = tid % (BK / 2);
    const uint loadc_b = tid / (BK / 2);
    const uint loadstride_b = BLOCK_SIZE * 2 / BK;

    float sums[WMITER * TM * WNITER * TN];
    [[unroll]] for (uint i = 0; i < WMITER * TM * WNITER * TN; i++) sums[i] = 0.0f;

    if (NDBUF == 2u) {
        /* ping-pong staging -- prefetch block bi+1 before computing bi; ONE barrier
         * per block (the tail barrier orders the prefetched writes for the next
         * compute AND the current compute's reads before the next-next prefetch
         * reuses the slot). Same FMA order per accumulator => bitwise vs the single
         * buffer. */
        uint nblk2 = (end_k - start_k + BK - 1u) / BK;
        [[unroll]] for (uint l = 0; l < BM; l += loadstride_a)
            load_a_to_shmem(0u, o0, loadr_a, loadc_a + l, start_k);
        [[unroll]] for (uint l = 0; l < BN; l += loadstride_b)
            load_b_to_shmem(0u, s0, loadr_b, loadc_b + l, start_k);
        barrier();
        for (uint bi = 0u; bi < nblk2; bi++) {
            const uint cb = bi & 1u;
            const uint kn = start_k + (bi + 1u) * BK;
            if (kn < end_k) {
                [[unroll]] for (uint l = 0; l < BM; l += loadstride_a)
                    load_a_to_shmem(cb ^ 1u, o0, loadr_a, loadc_a + l, kn);
                [[unroll]] for (uint l = 0; l < BN; l += loadstride_b)
                    load_b_to_shmem(cb ^ 1u, s0, loadr_b, loadc_b + l, kn);
            }
            MM8_COMPUTE(cb);
            barrier();
        }
    } else
    for (uint block = start_k; block < end_k; block += BK) {
        [[unroll]] for (uint l = 0; l < BM; l += loadstride_a)
            load_a_to_shmem(0u, o0, loadr_a, loadc_a + l, uint(block));
        [[unroll]] for (uint l = 0; l < BN; l += loadstride_b)
            load_b_to_shmem(0u, s0, loadr_b, loadc_b + l, uint(block));
        barrier();
        MM8_COMPUTE(0u);
        barrier();
    }

    // store (golden :527-553; dst[s*O + o] == golden dst[(n)*M + m]). ik==0
    // (unsplit) makes the partial base exactly the plain output address.
    const uint o_base = ir * BM + warp_r * WM;
    const uint s_base = ic * BN + warp_c * WN;
    [[unroll]] for (uint wsic = 0; wsic < WNITER; wsic++)
        [[unroll]] for (uint wsir = 0; wsir < WMITER; wsir++) {
            const uint o_w = o_base + wsir * WSUBM + tiwr * TM;
            const uint s_w = s_base + wsic * WSUBN + tiwc * TN;
            [[unroll]] for (uint cc = 0; cc < TN; cc++)
                [[unroll]] for (uint j = 0; j < TM; j++) {
                    const uint idx = (wsic * TN + cc) * WMITER * TM + wsir * TM + j;
                    if (o_w + j < uint(p.O) && s_w + cc < uint(p.S)) {
                        const uint split_base = ik * (uint(p.S) * uint(p.O));
                        y[split_base + (s_w + cc) * uint(p.O) + (o_w + j)] = sums[idx];
                    }
                }
        }
}
