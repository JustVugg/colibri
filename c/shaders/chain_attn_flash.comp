#version 450
// The dense chain's attention core on the matrix units (vk_chain.c, VKC_P_ATTN_FLASH):
// chain_attn.comp's causal case (no selection list or second V width, a head-major cache;
// a sliding window, a ring and a sink logit per head as chain_attnb.comp takes them) for a
// prompt chunk, KHR cooperative matrix f16 x f16 -> f32.
// Same bindings and push constants as chain_attn.comp, so vkc_attn_w picks either.
// After llama.cpp's flash_attn_cm1.comp (MIT): BC keys a step, 256 invocations, the
// softmax on a shared copy of the scores. For Qwen3.6 on RADV, Flint on an RTX PRO 4000:
//  * GQA folded: a workgroup takes 64 query rows, 64/GQ tokens x the GQ query heads of ONE
//    kv head, so every K/V block is staged once for all of them (16 rows a workgroup
//    staged each block four times as often: 7.8 of a 16K Flint prompt's 16.8 s of device
//    time on an RTX PRO 4000);
//  * every subgroup does matrix work: subgroup s takes row tile s % 4 (16 rows), and of
//    its key tiles and output dims the share s / 4 of SPLIT (1 at subgroups of 64, 2 at 32);
//  * two passes instead of an online softmax: pass 1 finds each row's max m and sum l,
//    pass 2 recomputes the scores and adds exp(s - m) * V straight into the
//    accumulators (no rescaling, O never leaves the registers), / l at the end;
//  * K/V arrive f32 and are converted to f16 while staged, in 16x16 tiles stored
//    contiguously (strided cooperative-matrix loads measured slow on RADV);
//  * causality inline: key t is valid for row r iff t <= pos_base + token(r), and with a
//    window (win > 0) t > pos_base + token(r) - win; the key blocks before the first row's
//    window are skipped. A ring (ring > 0) keeps position t in row t % ring. A sink starts
//    each row's softmax at m = sink, l = 1 (one more term of the denominator, no value).
// Q is scaled before its f16 rounding; P = exp(s - m) is in (0, 1]. Not bit-identical
// to chain_attn.comp (f16 operands); the CPU's order differs from both anyway.
// Grid: x = ceil(S / (64/GQ)) token groups, y = kv heads. HD, GQ, BC and SPLIT are
// specialization constants (HD a multiple of 64 up to 256, GQ dividing 64, BC 64 or 32,
// 256 / subgroup size / 4 for SPLIT).
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint HD = 256;   // head dim, multiple of 64
layout(constant_id = 1) const uint GQ = 8;     // query heads per kv head, divides 64
layout(constant_id = 2) const uint BC = 32;    // keys per block: 64, or 32 at head dim 256
layout(constant_id = 3) const uint SPLIT = 1;  // subgroups a row tile (8 subgroups of 32: 2)
#define R 64u                                  // query rows a workgroup
#define TPW (R / GQ)                           // tokens a workgroup
#define NDT (HD / 16u)                         // 16-wide head-dim tiles
#define KT (BC / 16u)                          // 16-key tiles a block
#define KTS (KT / SPLIT)                       // a subgroup's key tiles
#define NDS (NDT / SPLIT)                      // a subgroup's output dim tiles

layout(std430, binding = 0) readonly buffer QB { float q[]; };
layout(std430, binding = 1) readonly buffer KB { float kc[]; };   // K[k_off + (kvh*cap + t)*hd + d]
layout(std430, binding = 2) readonly buffer VB { float vc[]; };   // V likewise from v_off
layout(constant_id = 7) const bool KV16 = false;   // K and V float16 (vk_chain.c's vkc_attn_h): eight halves a load, as staged
layout(std430, binding = 1) readonly buffer KBH { uvec4 kch[]; };
layout(std430, binding = 2) readonly buffer VBH { uvec4 vch[]; };
layout(std430, binding = 3) buffer OB { float o[]; };
layout(std430, binding = 4) readonly buffer GB { float gt[]; };
layout(std430, binding = 6) readonly buffer SB { float snk[]; };
layout(push_constant) uniform P {   // chain_attn.comp's; the fields after v_off are zero here
    int S, H, KVH, hd, pos_base, cap;
    int q_off, q_row, q_seg;
    int g_off, g_row, g_seg, has_gate;
    int o_off, o_row;
    int sel_off, sel_row;
    float scale;
    int k_off, v_off;
    int win, ring, vd, kv_pm, sink, sink_off;
} p;

// K or V block (or BC rows of Q before the loop), f16, 16x16 tiles of 256 values each:
// tile (a, b) at (a * NDT + b) * 256, element (row, col) at row * 16 + col.
// K: a = key tile, b = dim tile, row = key, col = dim -> loaded ColumnMajor as B(dim, key)
// V: same layout                                     -> loaded RowMajor as B(key, dim)
shared uvec4 skv[BC * HD / 8u];
shared float ss[R * BC];               // scores, tile (row tile, key tile) at (rt * KT + kt) * 256; output staging at the end
shared float16_t sp[R * BC];           // P, the same tiles
shared float sinvl[R];                 // 1 / l per row

uint pk(float a, float b) { return packFloat2x16(f16vec2(float16_t(a), float16_t(b))); }
// an activation operand: held to +-65504 (a value past it would round to inf and the tile's
// sums with it; the CUDA f16 GEMMs hold x the same way), a NaN kept a NaN. The weights, a
// format's codes times its scales, stay well inside f16 and skip it (the hold on them cost
// Qwen3.6's prompt 4%)
float h16(float a) { return isnan(a) ? a : clamp(a, -65504.0, 65504.0); }
uint pkx(float a, float b) { return pk(h16(a), h16(b)); }

// stage keys k0 .. k0+BC-1 of kv head g from f32 memory into skv (zero past nt)
void stage(uint g, uint k0, uint nt, uint tid, bool isv) {
    for (uint e = tid; e < BC * HD / 8u; e += 256u) {
        uint kl = e / (HD / 8u), d8 = e % (HD / 8u);   // consecutive threads: consecutive dims of one key
        uint key = k0 + kl, d = d8 * 8u;
        uint at = ((kl >> 4u) * NDT + (d8 >> 1u)) * 32u + (kl & 15u) * 2u + (d8 & 1u);
        if (KV16) {   // the halves as they are (the offsets multiples of eight)
            uvec4 w = uvec4(0u);
            if (key < nt) {
                uint base = (g * uint(p.cap) + (p.ring > 0 ? key % uint(p.ring) : key)) * HD + d;
                w = isv ? vch[(base + uint(p.v_off)) >> 3u] : kch[(base + uint(p.k_off)) >> 3u];
            }
            skv[at] = w;
            continue;
        }
        vec4 a = vec4(0.0), b = vec4(0.0);
        if (key < nt) {
            uint base = (g * uint(p.cap) + (p.ring > 0 ? key % uint(p.ring) : key)) * HD + d;
            if (isv) { base += uint(p.v_off); a = vec4(vc[base], vc[base+1u], vc[base+2u], vc[base+3u]); b = vec4(vc[base+4u], vc[base+5u], vc[base+6u], vc[base+7u]); }
            else     { base += uint(p.k_off); a = vec4(kc[base], kc[base+1u], kc[base+2u], kc[base+3u]); b = vec4(kc[base+4u], kc[base+5u], kc[base+6u], kc[base+7u]); }
        }
        skv[at] = uvec4(pkx(a.x, a.y), pkx(a.z, a.w), pkx(b.x, b.y), pkx(b.z, b.w));
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x, sgi = gl_SubgroupID, lane = gl_SubgroupInvocationID;
    uint S = uint(p.S), g = gl_WorkGroupID.y;
    uint t0 = gl_WorkGroupID.x * TPW;
    uint nt = uint(p.pos_base) + S;
    uint tlast = min(t0 + TPW, S) - 1u;
    uint nkb = (uint(p.pos_base) + tlast) / BC + 1u;          // key blocks this workgroup needs
    uint win = uint(max(p.win, 0)), first = uint(p.pos_base) + t0;   // the first row's position
    uint kb_lo = win > 0u && first + 1u > win ? (first + 1u - win) / BC : 0u;   // blocks before it hold no key of any row
    uint rt = sgi % 4u, part = sgi / 4u;                        // this subgroup's row tile and share of it

    // softmax thread layout: row = tid / 4, 4 lanes per row, keys cl + 4 i
    uint row = tid >> 2u, cl = tid & 3u;
    uint rtok = t0 + row / GQ;
    uint qpos = uint(p.pos_base) + min(rtok, S - 1u);

    // Q (scaled) -> f16 A tiles in registers, BC rows at a time through skv
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A[NDT];
    [[unroll]] for (uint r0 = 0u; r0 < R; r0 += BC) {
        for (uint e = tid; e < BC * HD / 8u; e += 256u) {
            uint rl = e / (HD / 8u), d8 = e % (HD / 8u), r = r0 + rl, tk = t0 + r / GQ, h = g * GQ + r % GQ;
            vec4 a = vec4(0.0), b = vec4(0.0);
            if (tk < S) {
                uint base = uint(p.q_off) + tk * uint(p.q_row) + h * uint(p.q_seg) + d8 * 8u;
                a = vec4(q[base], q[base+1u], q[base+2u], q[base+3u]) * p.scale;
                b = vec4(q[base+4u], q[base+5u], q[base+6u], q[base+7u]) * p.scale;
            }
            skv[((rl >> 4u) * NDT + (d8 >> 1u)) * 32u + (rl & 15u) * 2u + (d8 & 1u)] = uvec4(pkx(a.x, a.y), pkx(a.z, a.w), pkx(b.x, b.y), pkx(b.z, b.w));
        }
        barrier();
        if (rt * 16u >= r0 && rt * 16u < r0 + BC)
            [[unroll]] for (uint j = 0u; j < NDT; j++)
                coopMatLoad(A[j], skv, (((rt * 16u - r0) >> 4u) * NDT + j) * 32u, 2u, gl_CooperativeMatrixLayoutRowMajor);
        barrier();
    }

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> Sc;
    float m = -1e30, l = 0.0;
    if (p.sink != 0) { m = snk[uint(p.sink_off) + g * GQ + row % GQ]; l = 1.0; }

    // pass 1: row max and sum
    for (uint kb = kb_lo; kb < nkb; kb++) {
        stage(g, kb * BC, nt, tid, false);
        barrier();
        [[unroll]] for (uint i = 0u; i < KTS; i++) {
            uint kt = part * KTS + i;
            Sc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
            [[unroll]] for (uint j = 0u; j < NDT; j++) {
                coopMatLoad(B, skv, (kt * NDT + j) * 32u, 2u, gl_CooperativeMatrixLayoutColumnMajor);
                Sc = coopMatMulAdd(A[j], B, Sc);
            }
            coopMatStore(Sc, ss, (rt * KT + kt) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();
        float bm = -1e30, part_l = 0.0;
        float sv[BC / 4u];
        [[unroll]] for (uint i = 0u; i < BC / 4u; i++) {
            uint kl = i * 4u + cl, key = kb * BC + kl;
            sv[i] = key <= qpos && (win == 0u || key + win > qpos) ? ss[((row >> 4u) * KT + (kl >> 4u)) * 256u + (row & 15u) * 16u + (kl & 15u)] : -1e30;
            bm = max(bm, sv[i]);
        }
        bm = subgroupClusteredMax(bm, 4u);
        float mn = max(m, bm);
        [[unroll]] for (uint i = 0u; i < BC / 4u; i++) part_l += sv[i] > -1e29 ? exp(sv[i] - mn) : 0.0;
        l = l * exp(m - mn) + subgroupClusteredAdd(part_l, 4u);
        m = mn;
        barrier();                                   // skv and ss are rewritten next block
    }
    // P stays exp(s - m) in (0, 1] and O is divided by l at the end: normalised
    // probabilities of a long row fall below f16's normal range (6e-5)
    if (cl == 0u) sinvl[row] = 1.0 / l;

    // pass 2: O = sum_t exp(s - m) * V  (/ l at the end)
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> Oa[NDS];
    [[unroll]] for (uint u = 0u; u < NDS; u++) Oa[u] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> PA;
    for (uint kb = kb_lo; kb < nkb; kb++) {
        stage(g, kb * BC, nt, tid, false);
        barrier();
        [[unroll]] for (uint i = 0u; i < KTS; i++) {
            uint kt = part * KTS + i;
            Sc = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
            [[unroll]] for (uint j = 0u; j < NDT; j++) {
                coopMatLoad(B, skv, (kt * NDT + j) * 32u, 2u, gl_CooperativeMatrixLayoutColumnMajor);
                Sc = coopMatMulAdd(A[j], B, Sc);
            }
            coopMatStore(Sc, ss, (rt * KT + kt) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();                                   // scores complete, K block consumed
        [[unroll]] for (uint i = 0u; i < BC / 4u; i++) {
            uint kl = i * 4u + cl, key = kb * BC + kl;
            uint at = ((row >> 4u) * KT + (kl >> 4u)) * 256u + (row & 15u) * 16u + (kl & 15u);
            sp[at] = float16_t(key <= qpos && (win == 0u || key + win > qpos) ? exp(ss[at] - m) : 0.0);
        }
        stage(g, kb * BC, nt, tid, true);
        barrier();
        [[unroll]] for (uint kt = 0u; kt < KT; kt++) {
            coopMatLoad(PA, sp, (rt * KT + kt) * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint u = 0u; u < NDS; u++) {
                coopMatLoad(B, skv, (kt * NDT + part * NDS + u) * 32u, 2u, gl_CooperativeMatrixLayoutRowMajor);
                Oa[u] = coopMatMulAdd(PA, B, Oa[u]);
            }
        }
        barrier();
    }

    // out: rows map to (token, head), not a uniform stride -> via this subgroup's 256 floats of ss
    [[unroll]] for (uint u = 0u; u < NDS; u++) {
        coopMatStore(Oa[u], ss, sgi * 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared(); subgroupBarrier();
        for (uint e = lane; e < 256u; e += gl_SubgroupSize) {
            uint r = rt * 16u + (e >> 4u), c = e & 15u, tk = t0 + r / GQ, h = g * GQ + r % GQ;
            if (tk < S) {
                uint d = (part * NDS + u) * 16u + c;
                float v = ss[sgi * 256u + e] * sinvl[r];
                if (p.has_gate != 0) v *= 1.0 / (1.0 + exp(-gt[uint(p.g_off) + tk * uint(p.g_row) + h * uint(p.g_seg) + d]));
                o[uint(p.o_off) + tk * uint(p.o_row) + h * HD + d] = v;
            }
        }
        subgroupMemoryBarrierShared(); subgroupBarrier();
    }
}
