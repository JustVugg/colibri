 CUTLASS_HOST_DEVICE float fast_rcp(const float& x) {
+#ifdef __CUDA_ARCH__
     float ret;
     asm volatile("rcp.approx.ftz.f32 %0, %1;" : "=f"(ret) : "f"(x));
     return ret;
+#else
+    /* MSVC x64 host pass has no inline asm; the host fallback only needs to
+     * be arithmetically reasonable, it is never on the kernel path. */
+    return 1.0f / x;
+#endif
 }
 
