+    const int S = 72, pb = 7, H = 16, KVH = 2, hd = 256, T = pb + S;
+    size_t qn = (size_t)S * H * hd, kn = (size_t)KVH * T * hd, bytes = qn * 4;
+    float *q = fvec(qn, 1.f), *kc = fvec(kn, 1.f), *vc = fvec(kn, 1.f);
